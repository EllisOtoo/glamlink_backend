generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vendor {
  id                    String                 @id @default(cuid())
  businessName          String
  handle                String                 @unique
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  userId                String?                @unique
  bio                   String?
  contactEmail          String?
  instagramHandle       String?
  kycSubmittedAt        DateTime?
  locationArea          String?
  phoneNumber           String?
  rejectionReason       String?
  reviewedById          String?
  status                VendorStatus           @default(DRAFT)
  verifiedAt            DateTime?
  websiteUrl            String?
  logoStorageKey        String?
  logoVersion           Int                    @default(0)
  latitude              Float?
  longitude             Float?
  serviceRadiusKm       Int?                   @default(15)
  onboardingStep        Int?                   @default(0)
  availabilityOverrides AvailabilityOverride[]
  bookings              Booking[]
  calendarEntries       BookingCalendarEntry[]
  giftCards             GiftCard[]
  documents             KycDocument[]
  payoutRequests        PayoutRequest[]
  portfolio             PortfolioItem[]
  reviews               Review[]
  services              Service[]
  seats                 ServiceSeat[]
  staff                 StaffMember[]
  supplyOrders          SupplyOrder[]
  reviewedBy            User?                  @relation("VendorReviewedBy", fields: [reviewedById], references: [id])
  user                  User?                  @relation(fields: [userId], references: [id])
  payoutMethods         VendorPayoutMethod[]
  statusHistory         VendorStatusHistory[]
  walletTransactions    WalletTransaction[]
  weeklyHours           WeeklyAvailability[]

  @@index([status])
}

model PortfolioItem {
  id          String            @id @default(cuid())
  vendorId    String
  storageKey  String?
  caption     String?
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  externalUrl String?
  type        PortfolioItemType @default(IMAGE)
  vendor      Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model User {
  id                      String                 @id @default(cuid())
  email                   String                 @unique
  role                    UserRole               @default(CUSTOMER)
  lastSignedInAt          DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  firebaseUid             String?                @unique
  createdBookings         Booking[]              @relation("CreatedBookings")
  customerBookings        Booking[]              @relation("CustomerBookings")
  calendarEntries         BookingCalendarEntry[] @relation("CalendarCustomerEntries")
  customerProfile         CustomerProfile?
  emailOtps               EmailOtp[]
  platformSettingsUpdated PlatformSetting[]      @relation("PlatformSettingUpdatedBy")
  pushTokens              PushToken[]
  writtenReviews          Review[]
  sessions                Session[]
  reviewedVendors         Vendor[]               @relation("VendorReviewedBy")
  vendor                  Vendor?
  statusEvents            VendorStatusHistory[]  @relation("VendorStatusActor")
}

model EmailOtp {
  id           String    @id @default(cuid())
  email        String
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([expiresAt])
  @@index([email, consumedAt])
}

model KycDocument {
  id         String   @id @default(cuid())
  vendorId   String
  type       String
  fileName   String
  storageKey String
  mimeType   String?
  sizeBytes  Int?
  uploadedAt DateTime @default(now())
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model VendorStatusHistory {
  id         String        @id @default(cuid())
  vendorId   String
  fromStatus VendorStatus?
  toStatus   VendorStatus
  reason     String?
  actorId    String?
  createdAt  DateTime      @default(now())
  actor      User?         @relation("VendorStatusActor", fields: [actorId], references: [id])
  vendor     Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([actorId])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  userAgent  String?
  clientIp   String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Service {
  id              String                 @id @default(cuid())
  vendorId        String
  name            String
  description     String?
  priceCents      Int
  durationMinutes Int
  bufferMinutes   Int                    @default(0)
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  depositPercent  Int?
  categoryId      String?
  bookings        Booking[]
  calendarEntries BookingCalendarEntry[]
  category        Category?              @relation(fields: [categoryId], references: [id])
  vendor          Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  images          ServiceImage[]
  seatLinks       ServiceSeatService[]

  @@index([vendorId, isActive])
  @@index([categoryId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  icon      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]

  @@index([slug])
}

model ServiceImage {
  id         String   @id @default(cuid())
  serviceId  String
  storageKey String
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model WeeklyAvailability {
  id          String   @id @default(cuid())
  vendorId    String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, dayOfWeek])
}

model AvailabilityOverride {
  id        String                   @id @default(cuid())
  vendorId  String
  startsAt  DateTime
  endsAt    DateTime
  type      AvailabilityOverrideType
  reason    String?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  vendor    Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, startsAt])
}

model Booking {
  id                  String                 @id @default(cuid())
  reference           String                 @unique
  vendorId            String
  serviceId           String
  customerName        String
  customerEmail       String?
  customerPhone       String?
  status              BookingStatus          @default(PENDING)
  scheduledStart      DateTime
  scheduledEnd        DateTime
  pricePesewas        Int
  depositPesewas      Int
  balancePesewas      Int
  notes               String?
  cancelledAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  customerUserId      String?
  cancellationReason  String?
  cancelledBy         BookingCancelActor?
  rescheduleCount     Int                    @default(0)
  rescheduledAt       DateTime?
  reminderSentAt      DateTime?
  seatId              String?
  staffId             String?
  createdByUserId     String?
  source              BookingSource          @default(ONLINE)
  paidAt              DateTime?
  createdBy           User?                  @relation("CreatedBookings", fields: [createdByUserId], references: [id])
  customer            User?                  @relation("CustomerBookings", fields: [customerUserId], references: [id])
  seat                ServiceSeat?           @relation(fields: [seatId], references: [id])
  service             Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff               StaffMember?           @relation(fields: [staffId], references: [id])
  vendor              Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  calendarEntries     BookingCalendarEntry[]
  giftCardRedemptions GiftCardRedemption[]
  paymentIntent       PaymentIntent?
  review              Review?
  walletTransactions  WalletTransaction[]

  @@index([vendorId, scheduledStart])
  @@index([vendorId, status])
  @@index([serviceId, scheduledStart])
  @@index([customerUserId, scheduledStart])
  @@index([seatId, scheduledStart])
  @@index([staffId, scheduledStart])
}

model PaymentIntent {
  id            String          @id @default(cuid())
  bookingId     String?         @unique
  provider      PaymentProvider
  providerRef   String          @unique
  status        PaymentStatus   @default(REQUIRES_PAYMENT_METHOD)
  amountPesewas Int
  currency      String          @default("GHS")
  metadata      Json?
  lastError     String?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  giftCardId    String?         @unique
  booking       Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  giftCard      GiftCard?       @relation("GiftCardPaymentIntent", fields: [giftCardId], references: [id])
  supplyOrder   SupplyOrder?
}

model GiftCard {
  id             String               @id @default(cuid())
  code           String               @unique
  vendorId       String
  valuePesewas   Int
  balancePesewas Int
  currency       String               @default("GHS")
  purchaserName  String
  purchaserEmail String
  purchaserPhone String?
  recipientName  String?
  recipientEmail String?
  message        String?
  status         GiftCardStatus       @default(PENDING_PAYMENT)
  expiresAt      DateTime?
  activatedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  vendor         Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  redemptions    GiftCardRedemption[]
  paymentIntent  PaymentIntent?       @relation("GiftCardPaymentIntent")

  @@index([vendorId])
  @@index([status])
  @@index([code])
}

model GiftCardRedemption {
  id                   String    @id @default(cuid())
  giftCardId           String
  bookingId            String?
  amountPesewas        Int
  depositAmountPesewas Int       @default(0)
  balanceAmountPesewas Int       @default(0)
  createdAt            DateTime  @default(now())
  refundedAt           DateTime?
  booking              Booking?  @relation(fields: [bookingId], references: [id])
  giftCard             GiftCard  @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId])
  @@index([bookingId])
}

model BookingCalendarEntry {
  id             String            @id @default(cuid())
  bookingId      String
  ownerType      CalendarOwnerType
  vendorId       String?
  customerUserId String?
  serviceId      String
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         BookingStatus
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  seatId         String?
  staffId        String?
  booking        Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer       User?             @relation("CalendarCustomerEntries", fields: [customerUserId], references: [id])
  seat           ServiceSeat?      @relation(fields: [seatId], references: [id])
  service        Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff          StaffMember?      @relation(fields: [staffId], references: [id])
  vendor         Vendor?           @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([bookingId, ownerType])
  @@index([vendorId, scheduledStart])
  @@index([customerUserId, scheduledStart])
  @@index([seatId, scheduledStart])
  @@index([staffId, scheduledStart])
}

model StaffMember {
  id               String                 @id @default(cuid())
  vendorId         String
  name             String
  bio              String?
  avatarStorageKey String?
  specialties      String[]               @default([])
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  bookings         Booking[]
  calendarEntries  BookingCalendarEntry[]
  seats            ServiceSeat[]
  vendor           Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, isActive])
}

model ServiceSeat {
  id              String                 @id @default(cuid())
  vendorId        String
  label           String
  description     String?
  capacity        Int                    @default(1)
  isActive        Boolean                @default(true)
  staffId         String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  bookings        Booking[]
  calendarEntries BookingCalendarEntry[]
  staff           StaffMember?           @relation(fields: [staffId], references: [id])
  vendor          Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  services        ServiceSeatService[]

  @@index([vendorId, isActive])
  @@index([staffId])
}

model ServiceSeatService {
  serviceId String
  seatId    String
  seat      ServiceSeat @relation(fields: [seatId], references: [id], onDelete: Cascade)
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([serviceId, seatId])
  @@index([seatId])
}

model PushToken {
  id               String       @id @default(cuid())
  userId           String
  token            String       @unique
  platform         PushPlatform @default(EXPO)
  deviceName       String?
  appVersion       String?
  lastRegisteredAt DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerProfile {
  userId                 String    @id
  fullName               String?
  phoneNumber            String?
  dateOfBirth            DateTime?
  preferredPronouns      String?
  city                   String?
  country                String?
  profilePhotoStorageKey String?
  profilePhotoVersion    Int       @default(0)
  marketingOptIn         Boolean   @default(false)
  smsOptIn               Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneNumber])
}

model Review {
  id               String    @id @default(cuid())
  bookingId        String    @unique
  vendorId         String
  customerUserId   String
  rating           Int
  comment          String?
  reply            String?
  repliedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  mediaStorageKeys String[]  @default([])
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer         User      @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  vendor           Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([customerUserId])
}

model SupplySupplier {
  id           String            @id @default(cuid())
  name         String
  contactEmail String?
  phoneNumber  String?
  serviceAreas String[]          @default([])
  priority     Int?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  orderItems   SupplyOrderItem[]
  products     SupplyProduct[]

  @@index([isActive])
}

model SupplyProduct {
  id               String            @id @default(cuid())
  supplierId       String
  category         String
  name             String
  description      String?
  unit             String?
  leadTimeDays     Int?
  mediaUrl         String?
  attributes       Json?
  isActive         Boolean           @default(true)
  inStock          Boolean           @default(true)
  stockRefreshedAt DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  mediaStorageKey  String?
  orderItems       SupplyOrderItem[]
  prices           SupplyPrice[]
  supplier         SupplySupplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, isActive])
  @@index([category, isActive])
  @@index([inStock, isActive])
}

model SupplyPrice {
  id                String        @id @default(cuid())
  productId         String
  supplierCostCents Int
  markupBasisPoints Int
  vendorPriceCents  Int
  startsAt          DateTime      @default(now())
  endsAt            DateTime?
  createdAt         DateTime      @default(now())
  product           SupplyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, startsAt])
}

model SupplyOrder {
  id               String                     @id @default(cuid())
  vendorId         String
  totalCents       Int
  deliveryFeeCents Int                        @default(0)
  status           SupplyOrderStatus          @default(DRAFT)
  paymentIntentId  String?                    @unique
  note             String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  paymentIntent    PaymentIntent?             @relation(fields: [paymentIntentId], references: [id])
  vendor           Vendor                     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items            SupplyOrderItem[]
  history          SupplyOrderStatusHistory[]

  @@index([vendorId, status])
}

model SupplyOrderItem {
  id                String         @id @default(cuid())
  orderId           String
  productId         String
  supplierId        String
  name              String
  category          String
  unit              String?
  leadTimeDays      Int?
  quantity          Int
  vendorPriceCents  Int
  supplierCostCents Int
  createdAt         DateTime       @default(now())
  order             SupplyOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           SupplyProduct  @relation(fields: [productId], references: [id])
  supplier          SupplySupplier @relation(fields: [supplierId], references: [id])
}

model SupplyOrderStatusHistory {
  id         String             @id @default(cuid())
  orderId    String
  fromStatus SupplyOrderStatus?
  toStatus   SupplyOrderStatus
  note       String?
  createdAt  DateTime           @default(now())
  order      SupplyOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model PlatformSetting {
  id          String             @id @default(cuid())
  key         PlatformSettingKey @unique
  intValue    Int?
  updatedById String?
  updatedAt   DateTime           @default(now())
  updatedBy   User?              @relation("PlatformSettingUpdatedBy", fields: [updatedById], references: [id])

  @@index([key])
}

model VendorPayoutMethod {
  id             String           @id @default(cuid())
  vendorId       String
  type           PayoutMethodType @default(BANK_ACCOUNT)
  accountName    String
  currency       String           @default("GHS")
  isPrimary      Boolean          @default(false)
  accountNumber  String?
  bankName       String?
  branchCode     String?
  mobileNetwork  String?
  mobileNumber   String?
  isVerified     Boolean          @default(false)
  lastVerifiedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  payoutRequests PayoutRequest[]
  vendor         Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model WalletTransaction {
  id            String            @id @default(cuid())
  vendorId      String
  amountPesewas Int
  type          TransactionType
  status        TransactionStatus @default(COMPLETED)
  referenceId   String?
  description   String
  balanceAfter  Int?
  createdAt     DateTime          @default(now())
  availableAt   DateTime          @default(now())
  bookingId     String?
  booking       Booking?          @relation(fields: [bookingId], references: [id])
  vendor        Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, availableAt])
}

model PayoutRequest {
  id                String             @id @default(cuid())
  vendorId          String
  amountPesewas     Int
  currency          String             @default("GHS")
  payoutMethodId    String
  status            PayoutStatus       @default(REQUESTED)
  note              String?
  rejectionReason   String?
  requestedAt       DateTime           @default(now())
  processedAt       DateTime?
  destinationMethod VendorPayoutMethod @relation(fields: [payoutMethodId], references: [id])
  vendor            Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, status])
}

enum PortfolioItemType {
  IMAGE
  VIDEO
  LINK
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum AvailabilityOverrideType {
  BLOCK
  EXTEND
}

enum BookingStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  ONLINE
  MANUAL
}

enum PaymentProvider {
  PAYSTACK
}

enum PaymentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

enum GiftCardStatus {
  PENDING_PAYMENT
  ACTIVE
  DEPLETED
  CANCELLED
  EXPIRED
}

enum CalendarOwnerType {
  VENDOR
  CUSTOMER
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
  EXPO
}

enum BookingCancelActor {
  CUSTOMER
  VENDOR
  SYSTEM
}

enum SupplyOrderStatus {
  DRAFT
  REQUIRES_PAYMENT
  WAITING_ON_SUPPLIER
  CONFIRMED
  OUT_FOR_DELIVERY
  FULFILLED
  CANCELLED
}

enum PlatformSettingKey {
  SERVICE_MARKUP_BPS
}

enum PayoutMethodType {
  BANK_ACCOUNT
  MOBILE_MONEY
}

enum TransactionType {
  EARNING
  PAYOUT
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
  FAILED
}

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  cities    City[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model City {
  id        String   @id @default(cuid())
  name      String
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, regionId])
  @@index([regionId])
  @@index([name])
}
